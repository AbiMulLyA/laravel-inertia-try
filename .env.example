APP_NAME="Kominfo Laravel Base"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Untuk production, ganti ke "production"
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel_app
DB_USERNAME=postgres
DB_PASSWORD=your_password

# Session & Cache - Gunakan Redis untuk production
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache - Gunakan Redis untuk production
CACHE_STORE=database
CACHE_PREFIX=dinas_

# Queue - Gunakan Redis untuk production
QUEUE_CONNECTION=database

# Redis (uncomment untuk production)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem
FILESYSTEM_DISK=local

# Vite
VITE_APP_NAME="${APP_NAME}"

# Octane (untuk production performance)
OCTANE_SERVER=frankenphp

# JWT Authentication
# Generate secret with: php artisan jwt:secret
JWT_SECRET=your-jwt-secret-key-here
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true

# Observability
PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_INGEST_DRIVER=storage

# Redis-ready production profile
# REDIS_CLIENT=predis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis

# Upload Module - local VM/server storage
UPLOAD_DISK=uploads_private
UPLOAD_PRIVATE_DISK=uploads_private
UPLOAD_PUBLIC_DISK=uploads_public
UPLOAD_PRIVATE_PATH=/srv/dinas-pertanian/uploads/private
UPLOAD_PUBLIC_PATH=/srv/dinas-pertanian/uploads/public
UPLOAD_DEFAULT_VISIBILITY=private
UPLOAD_NAMING_STRATEGY=system
UPLOAD_PATH_STRATEGY=category_date
UPLOAD_MAX_FILES_PER_REQUEST=1
UPLOAD_TEMP_TTL_MINUTES=120

# Upload Categories
UPLOAD_IMAGE_ENABLED=true
UPLOAD_IMAGE_MAX_SIZE_KB=1024
UPLOAD_IMAGE_VISIBILITY=private
UPLOAD_IMAGE_OPTIMIZE=true
UPLOAD_IMAGE_MAX_WIDTH=1920
UPLOAD_IMAGE_MAX_HEIGHT=1920
UPLOAD_IMAGE_JPEG_QUALITY=82
UPLOAD_IMAGE_WEBP_QUALITY=82
UPLOAD_IMAGE_PNG_COMPRESSION=7

UPLOAD_DOCUMENT_ENABLED=true
UPLOAD_DOCUMENT_MAX_SIZE_KB=1024
UPLOAD_DOCUMENT_VISIBILITY=private
UPLOAD_DOCUMENT_OPTIMIZE=false

UPLOAD_SPREADSHEET_ENABLED=true
UPLOAD_SPREADSHEET_MAX_SIZE_KB=1024
UPLOAD_SPREADSHEET_VISIBILITY=private

UPLOAD_ARCHIVE_ENABLED=false
UPLOAD_ARCHIVE_MAX_SIZE_KB=1024
UPLOAD_ARCHIVE_VISIBILITY=private
